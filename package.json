{
  "name": "my-cms",
  "version": "0.1.0",
  "description": "CMS server built on @tomorrowos/sdk — device pairing, playlists, and digital-signage management with a built-in web panel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build-player": "tomorrowos build --platform tizen"
  },
  "dependencies": {
    "@tomorrowos/sdk": "^0.9.70",
    "dotenv": "^17.2.3",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
