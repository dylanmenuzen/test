{
  "name": "TomorrowOS Digital Signage - CMS build",
  "tagline": "Digital signage management",
  "targetPlatforms": ["tizen", "brightsign"],
  "primaryColor": "#FF8A3D",
  "secondaryColor": "#F5F3EF",
  "backgroundColor": "#FAFAF9",
  "textColor": "#0A0908",
  "logoPath": "./assets/tomorrowos-logo.svg",
  "logoPathOnDark": "./assets/tomorrowos-logo-white.svg",
  "fontFamily": "Inter",
  "activationScreen": {
    "headline": "Connect this screen",
