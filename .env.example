# Port the CMS server listens on (default 3000)
PORT=3000

# --- Storage (optional) ---
# By default the CMS uses a local SQLite file at ./data/tomorrowos.db, which
# survives restarts and needs no configuration.
#
# To use Postgres/Supabase instead, set one of the following. When set, the
# store factory switches to the Postgres driver automatically.
# SUPABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true
